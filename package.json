{
  "name": "@neaps/tide-predictor",
  "version": "0.1.1",
  "description": "Tide predictor",
  "repository": "https://github.com/neaps/tide-predictor",
  "author": "Kevin Miller <keveemiller@gmail.com>",
  "license": "MIT",
  "type": "module",
  "exports": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/eslint-plugin": "^1.0.0",
    "eslint": "^9.5.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsup": "^8.0.0",
    "vitest": "^1.6.0"
  },
  "scripts": {
    "build": "tsup src/index.js --format esm --sourcemap --minify",
    "build:watch": "tsup src/index.js --format esm --sourcemap --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "vitest",
    "test:ci": "vitest run --coverage"
  }
}
